<%- include(partial('header')) %>

<section class="hero-ecoflora animate-fade-in">
    <div class="container">
        <h1>Lleva la naturaleza a tu hogar</h1>
        <p class="lead mb-4">Plantas seleccionadas, domicilios seguros y asesoría personalizada</p>
        <a href="/catalogo" class="btn btn-ecoflora btn-lg me-2"><i class="bi bi-grid me-2"></i>Ver catálogo</a>
        <a href="/nosotros" class="btn btn-outline-light btn-lg">Conócenos</a>
    </div>
</section>

<div class="container my-5">
    <h2 class="text-center mb-4 fw-bold" style="color: var(--verde-oscuro);"><i class="bi bi-collection me-2"></i>Nuestras categorías</h2>
    <div class="row g-4 mb-5">
        <% categorias.forEach(function(cat) { %>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/catalogo?categoria=<%= cat.id_categoria %>" class="text-decoration-none">
                <div class="card h-100 text-center p-3 border-0 shadow-sm" style="border-radius: 15px;">
                    <div class="card-body">
                        <i class="bi <%= cat.icono %> fs-1 mb-2" style="color: var(--verde-medio);"></i>
                        <h6 class="card-title text-dark"><%= cat.nombre %></h6>
                    </div>
                </div>
            </a>
        </div>
        <% }) %>
    </div>

    <h2 class="text-center mb-4 fw-bold" style="color: var(--verde-oscuro);"><i class="bi bi-stars me-2"></i>Plantas destacadas</h2>
    <div class="row g-4">
        <% destacadas.forEach(function(planta) { %>
        <div class="col-md-6 col-lg-4">
            <div class="card card-planta h-100">
                <div style="overflow: hidden; height: 250px;">
                    <img src="<%= plantImage(planta.nombre) %>" class="card-img-top w-100 h-100" alt="<%= planta.nombre %>" style="object-fit: cover;">
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge-categoria mb-2 align-self-start"><%= planta.categoria %></span>
                    <h5 class="card-title fw-bold"><%= planta.nombre %></h5>
                    <p class="card-text text-muted small flex-grow-1"><%= excerpt(planta.descripcion, 100) %>...</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="precio-planta">$<%= formatPrice(planta.precio) %></span>
                        <a href="/planta/<%= planta.id_planta %>" class="btn btn-ecoflora btn-sm">Ver más</a>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<%- include(partial('footer')) %>
