<%- include(partial('header')) %>

<%
    const terminoUrl = busqueda ? 'busqueda=' + encodeURIComponent(busqueda) : '';
    const urlTodas = '/catalogo' + (terminoUrl ? '?' + terminoUrl : '');
    const total = plantas.length;
%>

<div class="container contenedor-pagina">
    <div class="catalogo-cabecera reveal">
        <div>
            <span class="seccion-etiqueta"><i class="bi bi-grid-3x3-gap"></i>Vivero</span>
            <h1 class="seccion-titulo text-start mb-0">Catálogo de plantas</h1>
        </div>
        <span class="cuenta-resultados"><strong><%= total %></strong> planta<%= total === 1 ? '' : 's' %> encontrada<%= total === 1 ? '' : 's' %></span>
    </div>

    <div class="filtro vidrio reveal" style="--i: 1">
        <form method="GET" action="/catalogo" class="row g-3 align-items-end">
            <% if (categoriaFiltro) { %>
            <input type="hidden" name="categoria" value="<%= categoriaFiltro %>">
            <% } %>
            <div class="col-md-8">
                <label class="form-label" for="busqueda">Buscar planta</label>
                <div class="buscador">
                    <i class="bi bi-search"></i>
                    <input type="text" id="busqueda" name="busqueda" class="form-control" placeholder="Nombre, nombre científico o descripción" value="<%= busqueda %>">
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-ecoflora flex-fill"><i class="bi bi-search me-2"></i>Buscar</button>
                <% if (categoriaFiltro || busqueda) { %>
                <a href="/catalogo" class="btn btn-suave"><i class="bi bi-x-lg me-1"></i>Limpiar</a>
                <% } %>
            </div>
            <div class="col-12">
                <div class="chips-filtro">
                    <a href="<%= urlTodas %>" class="chip-filtro <%= !categoriaFiltro ? 'activo' : '' %>"><i class="bi bi-grid"></i>Todas</a>
                    <% categorias.forEach(function(cat) { %>
                    <a href="/catalogo?categoria=<%= cat.id_categoria %><%= terminoUrl ? '&' + terminoUrl : '' %>" class="chip-filtro <%= Number(categoriaFiltro) === cat.id_categoria ? 'activo' : '' %>"><i class="bi <%= cat.icono %>"></i><%= cat.nombre %></a>
                    <% }) %>
                </div>
            </div>
        </form>
    </div>

    <% if (plantas.length) { %>
    <div class="row g-4">
        <% plantas.forEach(function(planta, i) { %>
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <%- include(partial('tarjeta'), { planta: planta, i: i % 4 }) %>
        </div>
        <% }) %>
    </div>
    <% } else { %>
    <div class="vacio vidrio reveal">
        <i class="bi bi-flower1"></i>
        <h3 class="mt-3">No encontramos plantas</h3>
        <p class="text-muted mb-3">Prueba con otro nombre o quita los filtros.</p>
        <a href="/catalogo" class="btn btn-ecoflora"><i class="bi bi-arrow-counterclockwise me-2"></i>Ver todo el catálogo</a>
    </div>
    <% } %>
</div>

<%- include(partial('footer')) %>
