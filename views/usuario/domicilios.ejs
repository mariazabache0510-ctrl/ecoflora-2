<%- include(partial('header')) %>

<div class="container my-5">
    <h2 class="fw-bold mb-4" style="color: var(--verde-oscuro);"><i class="bi bi-truck me-2"></i>Mis Domicilios</h2>
    <% if (exito) { %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>¡Pedido realizado con éxito!</div><% } %>
    <% if (!pedidos.length) { %>
        <div class="text-center py-5"><i class="bi bi-box-seam fs-1 text-muted"></i><p class="mt-3 text-muted">No tienes pedidos aún.</p><a href="/catalogo" class="btn btn-ecoflora">Ir a comprar</a></div>
    <% } else { %>
        <div class="row g-4">
            <% pedidos.forEach(function(pedido) { %>
            <div class="col-12">
                <div class="card shadow-sm border-0" style="border-radius: 15px;">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div><small class="text-muted">Pedido #<%= pedido.id_pedido %></small><span class="ms-2 badge bg-<%= COLORES_ESTADO[pedido.estado] %>"><%= pedido.estado %></span></div>
                        <small class="text-muted"><%= formatDate(pedido.fecha_pedido) %></small>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Envío a:</strong> <%= pedido.direccion_envio %>, <%= pedido.ciudad_envio || '' %></p>
                        <p class="mb-3"><i class="bi bi-telephone me-1"></i><%= pedido.telefono_contacto || '' %></p>
                        <ul class="list-group list-group-flush">
                            <% (pedido.detalle || []).forEach(function(linea) { %>
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><%= linea.nombre %> x<%= linea.cantidad %></span><span>$<%= formatPrice(linea.precio_unitario * linea.cantidad) %></span></li>
                            <% }) %>
                        </ul>
                        <div class="text-end mt-3"><strong class="fs-5" style="color: var(--verde-oscuro);">Total: $<%= formatPrice(pedido.total) %></strong></div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include(partial('footer')) %>
