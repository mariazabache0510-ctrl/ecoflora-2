<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="panel-cabecera reveal">
        <span class="panel-icono"><i class="bi bi-person-circle"></i></span>
        <div>
            <h1>Panel del Cliente</h1>
            <p>Bienvenido(a), <%= sesion.nombre %></p>
        </div>
    </div>

    <p class="text-muted reveal">Desde aquí puedes gestionar tus pedidos, editar tus datos y ver tu historial de navegación.</p>

    <div class="row g-3">
        <div class="col-md-6 col-xl-4 reveal" style="--i: 0">
            <a href="/catalogo" class="accion vidrio" style="--c1: #2d6a4f; --c2: #52b788">
                <span class="a-icono"><i class="bi bi-shop"></i></span>
                <div><strong>Ir a comprar</strong><small>Explora el catálogo</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 1">
            <a href="/usuario/domicilios" class="accion vidrio" style="--c1: #bc6c25; --c2: #e9a23b">
                <span class="a-icono"><i class="bi bi-truck"></i></span>
                <div><strong>Mis Pedidos</strong><small>Sigue tus domicilios</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 2">
            <a href="/usuario/perfil" class="accion vidrio" style="--c1: #7b4fc4; --c2: #b794f4">
                <span class="a-icono"><i class="bi bi-pencil"></i></span>
                <div><strong>Editar mis datos</strong><small>Perfil y dirección</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 3">
            <a href="/usuario/historial" class="accion vidrio" style="--c1: #0c6a94; --c2: #4aa8d8">
                <span class="a-icono"><i class="bi bi-clock-history"></i></span>
                <div><strong>Historial</strong><small>Páginas que visitaste</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 4">
            <a href="/rostro" class="accion vidrio" style="--c1: #1b7f5c; --c2: #5fd3a1">
                <span class="a-icono"><i class="bi bi-person-bounding-box"></i></span>
                <div><strong>Inicio con rostro</strong><small>Entra sin escribir tu contraseña</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 5">
            <a href="/logout" class="accion vidrio" style="--c1: #c9184a; --c2: #ff8fa3">
                <span class="a-icono"><i class="bi bi-box-arrow-right"></i></span>
                <div><strong>Cerrar sesión</strong><small>Salir de tu cuenta</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
