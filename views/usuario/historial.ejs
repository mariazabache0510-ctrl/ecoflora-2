<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="panel-cabecera reveal">
        <span class="panel-icono"><i class="bi bi-clock-history"></i></span>
        <div>
            <h1>Historial de Navegación</h1>
            <p>Las últimas páginas que visitaste</p>
        </div>
    </div>

    <div class="tabla-tarjeta vidrio reveal">
        <div class="table-responsive">
            <table class="table tabla-eco align-middle">
                <thead><tr><th>Página</th><th>URL</th><th>Fecha y hora</th></tr></thead>
                <tbody>
                    <% historial.forEach(function(visita, i) { %>
                    <tr style="--i: <%= i %>">
                        <td><span class="rol-pill rol-cliente"><%= ucfirst(String(visita.pagina || '').replace(/_/g, ' ')) %></span></td>
                        <td><small class="text-muted historial-url"><%= visita.url %></small></td>
                        <td><%= formatDate(visita.fecha_visita, true) %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="acciones-pie">
        <a href="/usuario" class="btn btn-suave"><i class="bi bi-arrow-left me-2"></i>Volver al panel</a>
    </div>
</div>

<%- include(partial('footer')) %>
