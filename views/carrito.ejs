<%- include(partial('header')) %>

<div class="container my-5">
    <h2 class="fw-bold mb-4" style="color: var(--verde-oscuro);"><i class="bi bi-cart3 me-2"></i>Tu carrito</h2>
    <% if (!items.length) { %>
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <p class="mt-3 text-muted">Tu carrito está vacío.</p>
            <a href="/catalogo" class="btn btn-ecoflora mt-2">Ir al catálogo</a>
        </div>
    <% } else { %>
        <form method="POST" action="/carrito">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="table-responsive">
                    <table class="table table-ecoflora mb-0 align-middle">
                        <thead><tr><th>Producto</th><th class="text-center">Precio</th><th class="text-center" style="width: 150px;">Cantidad</th><th class="text-end">Subtotal</th><th></th></tr></thead>
                        <tbody>
                            <% items.forEach(function(item) { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= plantImage(item.nombre, 'thumb') %>" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" alt="<%= item.nombre %>">
                                        <div class="ms-3"><h6 class="mb-0 fw-bold"><%= item.nombre %></h6></div>
                                    </div>
                                </td>
                                <td class="text-center">$<%= formatPrice(item.precio) %></td>
                                <td><input type="number" name="cant_<%= item.id_planta %>" value="<%= item.cantidad %>" min="1" max="<%= item.stock %>" class="form-control text-center"></td>
                                <td class="text-end fw-bold">$<%= formatPrice(item.precio * item.cantidad) %></td>
                                <td class="text-end"><a href="/carrito?eliminar=<%= item.id_planta %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Eliminar?')"><i class="bi bi-trash"></i></a></td>
                            </tr>
                            <% }) %>
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr><td colspan="3" class="text-end fw-bold fs-5">Total:</td><td class="text-end fw-bold fs-5" style="color: var(--verde-oscuro);">$<%= formatPrice(total) %></td><td></td></tr>
                        </tfoot>
                    </table>
                </div>
                <div class="card-footer bg-white border-0 p-3 d-flex justify-content-between">
                    <div><button type="submit" name="actualizar" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar</button></div>
                    <div>
                        <a href="/catalogo" class="btn btn-outline-ecoflora me-2">Seguir comprando</a>
                        <% if (sesion) { %>
                            <a href="/confirmar-pedido" class="btn btn-ecoflora"><i class="bi bi-truck me-1"></i>Solicitar domicilio</a>
                        <% } else { %>
                            <a href="/login" class="btn btn-ecoflora">Ingresa para continuar</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </form>
    <% } %>
</div>

<%- include(partial('footer')) %>
