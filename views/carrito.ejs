<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <h1 class="titulo-pagina reveal"><i class="bi bi-cart3"></i>Tu carrito</h1>

    <% if (!items.length) { %>
    <div class="vacio vidrio reveal">
        <i class="bi bi-cart-x"></i>
        <p class="mt-3 text-muted">Tu carrito está vacío.</p>
        <a href="/catalogo" class="btn btn-ecoflora mt-2"><i class="bi bi-grid me-2"></i>Ir al catálogo</a>
    </div>
    <% } else { %>
    <form method="POST" action="/carrito" data-actualizar-carrito>
        <div class="row g-4">
            <div class="col-lg-8">
                <% items.forEach(function(item, i) { %>
                <article class="item-carrito vidrio" style="--i: <%= i %>">
                    <a href="/planta/<%= item.id_planta %>"><%- plantImg(item, { width: 84, height: 84 }) %></a>
                    <div>
                        <h2><a href="/planta/<%= item.id_planta %>"><%= item.nombre %></a></h2>
                        <span class="item-precio">$<%= formatPrice(item.precio) %> c/u · Disponibles: <%= item.stock %></span>
                    </div>
                    <div class="item-lado">
                        <div class="stepper stepper-sm" data-stepper>
                            <button type="button" data-paso="-1" aria-label="Menos"><i class="bi bi-dash"></i></button>
                            <input type="number" name="cant_<%= item.id_planta %>" value="<%= item.cantidad %>" min="1" max="<%= item.stock %>" aria-label="Cantidad de <%= item.nombre %>">
                            <button type="button" data-paso="1" aria-label="Más"><i class="bi bi-plus"></i></button>
                        </div>
                        <span class="item-subtotal">$<%= formatPrice(item.precio * item.cantidad) %></span>
                        <a href="/carrito?eliminar=<%= item.id_planta %>" class="btn btn-peligro-suave btn-quitar" onclick="return confirm('¿Eliminar?')" aria-label="Quitar <%= item.nombre %>" title="Quitar"><i class="bi bi-trash"></i></a>
                    </div>
                </article>
                <% }) %>

                <div class="acciones-pie">
                    <button type="submit" name="actualizar" class="btn btn-suave" data-actualizar><i class="bi bi-arrow-clockwise me-2"></i>Actualizar</button>
                    <a href="/catalogo" class="btn btn-outline-ecoflora"><i class="bi bi-arrow-left me-2"></i>Seguir comprando</a>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="resumen vidrio reveal" style="--i: 2">
                    <h2 class="mb-3"><i class="bi bi-receipt me-2"></i>Resumen</h2>
                    <% items.forEach(function(item) { %>
                    <div class="resumen-linea">
                        <span><%= item.nombre %> <small class="text-muted">× <%= item.cantidad %></small></span>
                        <span>$<%= formatPrice(item.precio * item.cantidad) %></span>
                    </div>
                    <% }) %>
                    <div class="resumen-total">
                        <span>Total:</span>
                        <strong>$<%= formatPrice(total) %></strong>
                    </div>
                    <div class="d-grid mt-4">
                        <% if (sesion) { %>
                        <a href="/confirmar-pedido" class="btn btn-ecoflora btn-lg"><i class="bi bi-truck me-2"></i>Solicitar domicilio</a>
                        <% } else { %>
                        <a href="/login" class="btn btn-ecoflora btn-lg"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresa para continuar</a>
                        <% } %>
                    </div>
                </aside>
            </div>
        </div>
    </form>
    <% } %>
</div>

<%- include(partial('footer')) %>
