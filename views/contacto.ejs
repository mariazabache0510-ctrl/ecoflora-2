<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="row g-5">
        <div class="col-lg-5 reveal">
            <span class="seccion-etiqueta"><i class="bi bi-chat-heart"></i>Hablemos</span>
            <h1 class="seccion-titulo text-start">Contáctanos</h1>
            <p class="text-muted mb-4">¿Tienes dudas sobre el cuidado de una planta, disponibilidad o domicilios? Escríbenos.</p>
            <div class="info-contacto vidrio"><span class="icono"><i class="bi bi-geo-alt"></i></span><div><strong>Dirección</strong><span>Calle 123 #45-67, Bogotá</span></div></div>
            <div class="info-contacto vidrio"><span class="icono"><i class="bi bi-telephone"></i></span><div><strong>Teléfono</strong><span>(601) 123-4567</span></div></div>
            <div class="info-contacto vidrio"><span class="icono"><i class="bi bi-envelope"></i></span><div><strong>Email</strong><span>hola@ecoflora.com</span></div></div>
            <div class="info-contacto vidrio"><span class="icono"><i class="bi bi-clock"></i></span><div><strong>Horario</strong><span>Lun - Sáb: 8:00 a.m. - 6:00 p.m.</span></div></div>
        </div>
        <div class="col-lg-7">
            <div class="form-tarjeta vidrio reveal" style="--i: 1">
                <h2 class="h4 fw-bold mb-3"><i class="bi bi-envelope-paper me-2 text-success"></i>Envíanos un mensaje</h2>
                <% if (error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div><% } %>
                <% if (exito) { %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= exito %></div><% } %>
                <form method="POST" action="/contacto">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="nombre">Nombre *</label>
                            <div class="campo"><i class="bi bi-person"></i><input type="text" id="nombre" name="nombre" class="form-control" required></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="email">Email *</label>
                            <div class="campo"><i class="bi bi-envelope"></i><input type="email" id="email" name="email" class="form-control" required></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="telefono">Teléfono</label>
                            <div class="campo"><i class="bi bi-telephone"></i><input type="text" id="telefono" name="telefono" class="form-control"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="asunto">Asunto</label>
                            <div class="campo"><i class="bi bi-tag"></i><input type="text" id="asunto" name="asunto" class="form-control"></div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="mensaje">Mensaje *</label>
                        <textarea id="mensaje" name="mensaje" class="form-control" rows="4" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-ecoflora btn-lg w-100"><i class="bi bi-send me-2"></i>Enviar mensaje</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
