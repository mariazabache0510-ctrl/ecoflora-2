<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="panel-cabecera reveal">
        <span class="panel-icono"><i class="bi bi-geo-alt"></i></span>
        <div>
            <h1>Sitios de interés</h1>
            <p><%= esAdmin ? 'Como administrador ves los sitios de todos los usuarios.' : 'Marca en el mapa los lugares que te interesan: viveros, jardines, parques…' %></p>
        </div>
    </div>

    <% if (!disponible) { %>
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Los sitios de interés todavía no están disponibles en este sitio (falta conectar la base de datos). El resto de EcoFlora funciona con normalidad.</div>
    <% } else { %>

    <div class="row g-4"
         data-sitios
         data-maps-key="<%= mapsKey %>"
         data-csrf="<%= csrfToken %>"
         data-admin="<%= esAdmin ? '1' : '0' %>">
        <div class="col-lg-7 reveal">
            <div class="sitios-mapa vidrio" data-sitios-mapa>
                <div class="sitios-mapa-aviso" data-sitios-aviso>
                    <i class="bi bi-map"></i>
                    <% if (mapsKey) { %><span>Cargando el mapa…</span><% } else { %><span>El mapa todavía no está configurado en este sitio.<br>Aun así puedes guardar un sitio escribiendo sus coordenadas.</span><% } %>
                </div>
            </div>
            <p class="sitios-ayuda"><i class="bi bi-hand-index me-1"></i>Haz clic en el mapa para marcar un lugar. Puedes arrastrar el marcador para afinarlo.</p>
        </div>

        <div class="col-lg-5">
            <div class="tabla-tarjeta vidrio p-4 reveal">
                <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-2"></i>Nuevo sitio</h2>
                <div class="alert alert-danger" data-sitios-error role="alert" hidden></div>
                <form data-sitios-form novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="sitio-nombre">Nombre</label>
                        <input type="text" id="sitio-nombre" class="form-control" maxlength="100" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sitio-descripcion">Descripción <span class="text-muted">(opcional)</span></label>
                        <textarea id="sitio-descripcion" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sitio-categoria">Categoría</label>
                        <select id="sitio-categoria" class="form-select" required>
                            <% categorias.forEach(function(c) { %><option value="<%= c %>"><%= c.charAt(0).toUpperCase() + c.slice(1).replace('jardin', 'jardín') %></option><% }); %>
                        </select>
                    </div>
                    <div class="sitios-coords mb-3">
                        <div>
                            <label class="form-label" for="sitio-lat">Latitud</label>
                            <input type="text" id="sitio-lat" class="form-control" inputmode="decimal" autocomplete="off" placeholder="4.142">
                        </div>
                        <div>
                            <label class="form-label" for="sitio-lng">Longitud</label>
                            <input type="text" id="sitio-lng" class="form-control" inputmode="decimal" autocomplete="off" placeholder="-73.626">
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-ecoflora" data-sitios-guardar><i class="bi bi-geo-alt me-2"></i>Guardar sitio</button>
                        <button type="button" class="btn btn-suave" data-sitios-ubicacion hidden><i class="bi bi-crosshair me-2"></i>Usar mi ubicación</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 reveal">
            <div class="tabla-tarjeta vidrio p-4">
                <h2 class="h5 mb-3"><i class="bi bi-list-ul me-2"></i><%= esAdmin ? 'Todos los sitios' : 'Mis sitios' %></h2>
                <p class="sitios-estado" data-sitios-estado>Cargando…</p>
                <ul class="sitios-lista" data-sitios-lista></ul>
            </div>
        </div>
    </div>

    <script src="/js/sitios.js" nonce="<%= cspNonce %>"></script>
    <% } %>
</div>

<%- include(partial('footer')) %>
