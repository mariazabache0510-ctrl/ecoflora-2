<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="panel-cabecera panel-tierra reveal">
                <span class="panel-icono"><i class="bi bi-pencil-square"></i></span>
                <div>
                    <h1>Editar Usuario</h1>
                    <p><%= usuario.usuario %></p>
                </div>
            </div>

            <div class="form-tarjeta vidrio reveal" style="--i: 1">
                <form action="/admin/usuarios/<%= usuario.id_usuario %>" method="POST">
                    <div class="mb-3">
                        <label class="form-label" for="nombre">Nombre completo</label>
                        <div class="campo"><i class="bi bi-person-vcard"></i><input type="text" id="nombre" name="nombre" class="form-control" value="<%= usuario.nombre %>" required></div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="usuario">Usuario</label>
                            <div class="campo"><i class="bi bi-at"></i><input type="text" id="usuario" name="usuario" class="form-control" value="<%= usuario.usuario %>" required></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="email">Email</label>
                            <div class="campo"><i class="bi bi-envelope"></i><input type="email" id="email" name="email" class="form-control" value="<%= usuario.email %>" required></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="telefono">Teléfono</label>
                            <div class="campo"><i class="bi bi-telephone"></i><input type="text" id="telefono" name="telefono" class="form-control" value="<%= usuario.telefono || '' %>"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="ciudad">Ciudad</label>
                            <div class="campo"><i class="bi bi-geo-alt"></i><input type="text" id="ciudad" name="ciudad" class="form-control" value="<%= usuario.ciudad || '' %>"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="direccion">Dirección</label>
                        <div class="campo"><i class="bi bi-house-door"></i><input type="text" id="direccion" name="direccion" class="form-control" value="<%= usuario.direccion || '' %>"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rol">Rol</label>
                        <select id="rol" name="rol" class="form-select" required>
                            <option value="cliente" <%= usuario.rol === 'cliente' ? 'selected' : '' %>>Cliente</option>
                            <option value="admin" <%= usuario.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="password">Nueva contraseña</label>
                        <div class="campo con-ojo">
                            <i class="bi bi-lock"></i>
                            <input type="password" id="password" name="password" class="form-control" autocomplete="new-password">
                            <button type="button" class="campo-ojo" data-ver-clave aria-label="Mostrar u ocultar contraseña"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="form-text">Déjala vacía si no deseas cambiarla.</div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-tierra btn-lg"><i class="bi bi-check2-circle me-2"></i>Actualizar usuario</button>
                        <a href="/admin/usuarios" class="btn btn-suave">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
