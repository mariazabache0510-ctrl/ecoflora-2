<%- include(partial('header')) %>

<div class="container my-5">
    <div class="card shadow border-0" style="border-radius: 20px;">
        <div class="card-header bg-dark text-white" style="border-radius: 20px 20px 0 0;">
            <h4 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Panel de Administración</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="mb-3">Bienvenido(a), <%= sesion.nombre %></h5>
            <p class="text-muted">Desde aquí puedes gestionar usuarios, pedidos y el inventario de plantas.</p>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="card text-center p-3 border-0 shadow-sm"><h3 class="fw-bold text-success"><%= totalPlantas %></h3><small class="text-muted text-uppercase fw-bold">Plantas</small></div></div>
                <div class="col-md-3"><div class="card text-center p-3 border-0 shadow-sm"><h3 class="fw-bold text-warning"><%= totalPedidos %></h3><small class="text-muted text-uppercase fw-bold">Pedidos</small></div></div>
                <div class="col-md-3"><div class="card text-center p-3 border-0 shadow-sm"><h3 class="fw-bold text-primary"><%= totalUsuarios %></h3><small class="text-muted text-uppercase fw-bold">Clientes</small></div></div>
                <div class="col-md-3"><div class="card text-center p-3 border-0 shadow-sm"><h3 class="fw-bold text-danger"><%= pendientes %></h3><small class="text-muted text-uppercase fw-bold">Pendientes</small></div></div>
            </div>
            <div class="d-flex gap-3 flex-wrap">
                <a href="/admin/usuarios" class="btn btn-primary"><i class="bi bi-people me-2"></i>Gestionar Usuarios</a>
                <a href="/admin/pedidos" class="btn btn-success"><i class="bi bi-truck me-2"></i>Ver Pedidos / Domicilios</a>
                <a href="/" class="btn btn-outline-secondary"><i class="bi bi-shop me-2"></i>Ver tienda</a>
                <a href="/logout" class="btn btn-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a>
            </div>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
