<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="panel-cabecera reveal">
        <span class="panel-icono"><i class="bi bi-speedometer2"></i></span>
        <div>
            <h1>Panel de Administración</h1>
            <p>Bienvenido(a), <%= sesion.nombre %></p>
        </div>
    </div>

    <p class="text-muted reveal">Desde aquí puedes gestionar usuarios, pedidos y el inventario de plantas.</p>

    <div class="row g-4 mb-4">
        <div class="col-6 col-lg-3 reveal" style="--i: 0">
            <div class="dato vidrio" style="--c1: #2d6a4f; --c2: #52b788">
                <i class="bi bi-flower2 dato-icono"></i>
                <span class="dato-numero" data-contar="<%= totalPlantas %>"><%= totalPlantas %></span>
                <span class="dato-etiqueta">Plantas</span>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal" style="--i: 1">
            <div class="dato vidrio" style="--c1: #bc6c25; --c2: #e9a23b">
                <i class="bi bi-bag-check dato-icono"></i>
                <span class="dato-numero" data-contar="<%= totalPedidos %>"><%= totalPedidos %></span>
                <span class="dato-etiqueta">Pedidos</span>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal" style="--i: 2">
            <div class="dato vidrio" style="--c1: #0c6a94; --c2: #4aa8d8">
                <i class="bi bi-people dato-icono"></i>
                <span class="dato-numero" data-contar="<%= totalUsuarios %>"><%= totalUsuarios %></span>
                <span class="dato-etiqueta">Clientes</span>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal" style="--i: 3">
            <div class="dato vidrio" style="--c1: #c9184a; --c2: #ff8fa3">
                <i class="bi bi-hourglass-split dato-icono"></i>
                <span class="dato-numero" data-contar="<%= pendientes %>"><%= pendientes %></span>
                <span class="dato-etiqueta">Pendientes</span>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-xl-4 reveal" style="--i: 0">
            <a href="/admin/usuarios" class="accion vidrio" style="--c1: #2d6a4f; --c2: #52b788">
                <span class="a-icono"><i class="bi bi-people"></i></span>
                <div><strong>Gestionar Usuarios</strong><small>Editar o eliminar cuentas</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 1">
            <a href="/admin/pedidos" class="accion vidrio" style="--c1: #bc6c25; --c2: #e9a23b">
                <span class="a-icono"><i class="bi bi-truck"></i></span>
                <div><strong>Ver Pedidos / Domicilios</strong><small>Cambiar estados</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 2">
            <a href="/admin/inventario" class="accion vidrio" style="--c1: #7a4a17; --c2: #d99a3d">
                <span class="a-icono"><i class="bi bi-boxes"></i></span>
                <div><strong>Inventario / Stock</strong><small><%= stockBajo > 0 ? stockBajo + ' por reponer' : 'Añadir o ajustar unidades' %></small></div>
                <% if (stockBajo > 0) { %><span class="accion-badge"><%= stockBajo %></span><% } %>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 3">
            <a href="/admin/mensajes" class="accion vidrio" style="--c1: #128c7e; --c2: #25d366">
                <span class="a-icono"><i class="bi bi-chat-dots"></i></span>
                <div><strong>Mensajes de contacto</strong><small><%= mensajesSinLeer > 0 ? mensajesSinLeer + ' sin leer' : 'Todo al día' %></small></div>
                <% if (mensajesSinLeer > 0) { %><span class="accion-badge"><%= mensajesSinLeer %></span><% } %>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 4">
            <a href="/rostro" class="accion vidrio" style="--c1: #1b7f5c; --c2: #5fd3a1">
                <span class="a-icono"><i class="bi bi-person-bounding-box"></i></span>
                <div><strong>Inicio con rostro</strong><small>Activa tu rostro para entrar</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 5">
            <a href="/" class="accion vidrio" style="--c1: #0c6a94; --c2: #4aa8d8">
                <span class="a-icono"><i class="bi bi-shop"></i></span>
                <div><strong>Ver tienda</strong><small>Volver al vivero</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4 reveal" style="--i: 6">
            <a href="/logout" class="accion vidrio" style="--c1: #c9184a; --c2: #ff8fa3">
                <span class="a-icono"><i class="bi bi-box-arrow-right"></i></span>
                <div><strong>Cerrar sesión</strong><small>Salir del panel</small></div>
                <i class="bi bi-arrow-right a-flecha"></i>
            </a>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
