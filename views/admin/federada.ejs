<%- include(partial('header')) %>

<%
    const estadoPill = (ok) => ok ? '<span class="rol-pill rol-cliente">Conectado</span>' : '<span class="rol-pill rol-admin">Sin conexión</span>';
%>

<div class="container contenedor-pagina">
    <div class="panel-cabecera panel-tierra reveal">
        <span class="panel-icono"><i class="bi bi-diagram-3"></i></span>
        <div>
            <h1>Base de datos federada</h1>
            <p>PostgreSQL (clientes y productos) + MySQL (facturas), enlazados con mysql_fdw</p>
        </div>
    </div>

    <% if (error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div><% } %>
    <% if (sincronizado) { %>
        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>Sincronizado: <%= sincronizado.clientes %> clientes y <%= sincronizado.productos %> productos a Postgres; <%= sincronizado.facturas %> líneas de factura a MySQL<%= sincronizado.omitidas ? ' (' + sincronizado.omitidas + ' pedidos omitidos porque su cliente ya no existe)' : '' %>.</div>
    <% } %>

    <% if (!habilitada) { %>
        <div class="tabla-tarjeta vidrio reveal p-4">
            <h2 class="h5"><i class="bi bi-plug me-2"></i>La base federada está apagada</h2>
            <p>Esta parte funciona en tu computador con dos servidores locales (Docker). Para encenderla:</p>
            <ol>
                <li>En la carpeta <code>docker/</code>: copia <code>.env.example</code> como <code>.env</code> y ejecuta <code>docker compose up -d --build</code>.</li>
                <li>En el <code>.env</code> de la tienda define <code>PG_URL</code> y <code>MYSQL_URL</code> (ejemplos en <code>.env.example</code>).</li>
                <li>Reinicia la tienda y vuelve a esta pantalla.</li>
            </ol>
            <p class="mb-0 text-muted">En el sitio publicado en Render esta parte queda apagada a propósito: los dos servidores son locales y la tienda sigue funcionando con MongoDB.</p>
        </div>
    <% } else { %>
        <div class="row g-4 mb-4">
            <div class="col-md-4 reveal" style="--i: 0">
                <div class="dato vidrio" style="--c1: #0c6a94; --c2: #4aa8d8">
                    <i class="bi bi-database dato-icono"></i>
                    <span class="dato-etiqueta">Servidor 1 · PostgreSQL</span>
                    <span class="mt-1"><%- estadoPill(datos.servidorPg.ok) %></span>
                    <small class="mt-2 d-block"><%= datos.servidorPg.ok ? datos.servidorPg.version + ' · base ' + datos.servidorPg.base + ' · ' + datos.servidorPg.ms + ' ms' : datos.servidorPg.error %></small>
                </div>
            </div>
            <div class="col-md-4 reveal" style="--i: 1">
                <div class="dato vidrio" style="--c1: #bc6c25; --c2: #e9a23b">
                    <i class="bi bi-database-fill dato-icono"></i>
                    <span class="dato-etiqueta">Servidor 2 · MySQL</span>
                    <span class="mt-1"><%- estadoPill(datos.servidorMysql.ok) %></span>
                    <small class="mt-2 d-block"><%= datos.servidorMysql.ok ? datos.servidorMysql.version + ' · base ' + datos.servidorMysql.base + ' · ' + datos.servidorMysql.ms + ' ms' : datos.servidorMysql.error %></small>
                </div>
            </div>
            <div class="col-md-4 reveal" style="--i: 2">
                <div class="dato vidrio" style="--c1: #2d6a4f; --c2: #52b788">
                    <i class="bi bi-link-45deg dato-icono"></i>
                    <span class="dato-etiqueta">Enlace mysql_fdw (factura_mysql)</span>
                    <span class="mt-1"><%- estadoPill(datos.enlace.ok) %></span>
                    <small class="mt-2 d-block"><%= datos.enlace.ok ? 'Postgres lee ' + datos.enlace.filas + ' facturas de MySQL · ' + datos.enlace.ms + ' ms' : datos.enlace.error %></small>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 reveal">
            <form method="POST" action="/admin/federada/sincronizar" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-tierra"><i class="bi bi-arrow-repeat me-2"></i>Sincronizar ahora</button>
            </form>
            <span class="text-muted">Copia los clientes, plantas y pedidos de la tienda (MongoDB) a los dos servidores. Se puede repetir sin duplicar nada.
            <% if (datos.totales.clientes !== undefined) { %> Ahora hay <strong><%= datos.totales.clientes %></strong> clientes y <strong><%= datos.totales.productos %></strong> productos en Postgres<% } %><% if (datos.totales.facturas !== undefined) { %> y <strong><%= datos.totales.facturas %></strong> líneas de factura en MySQL ($<%= formatPrice(datos.totales.facturado) %>)<% } %>.</span>
        </div>

        <div class="tabla-tarjeta vidrio reveal mb-4">
            <div class="p-3 pb-0"><h2 class="h5"><i class="bi bi-intersect me-2"></i>Consulta federada (una sola consulta, dos servidores)</h2></div>
            <pre class="m-3 p-3 rounded-3" style="background: rgba(27,67,50,.06); font-size: .82rem; white-space: pre-wrap;"><%= datos.sqlVista %></pre>
            <div class="table-responsive">
                <table class="table tabla-eco align-middle">
                    <thead><tr><th>Factura</th><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Cant.</th><th>Precio</th><th>Total</th></tr></thead>
                    <tbody>
                    <% if (!datos.ventas.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Aún no hay facturas. Haz un pedido en la tienda o pulsa "Sincronizar ahora".</td></tr><% } %>
                    <% datos.ventas.forEach(function(v, i) { %>
                        <tr style="--i: <%= i %>"><td><%= v.numero %></td><td><%= v.fecha %></td><td><%= v.cliente %></td><td><%= v.producto %></td><td><%= v.cantidad %></td><td>$<%= formatPrice(v.precio_unitario) %></td><td><strong>$<%= formatPrice(v.total) %></strong></td></tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6 reveal">
                <div class="tabla-tarjeta vidrio h-100">
                    <div class="p-3 pb-0"><h2 class="h5"><i class="bi bi-people me-2"></i>cliente <small class="text-muted">(PostgreSQL)</small></h2></div>
                    <div class="table-responsive"><table class="table tabla-eco align-middle">
                        <thead><tr><th>ID</th><th>Nombre</th><th>Email</th><th>Ciudad</th></tr></thead>
                        <tbody>
                        <% if (!datos.clientes.length) { %><tr><td colspan="4" class="text-center text-muted py-3">Sin clientes todavía</td></tr><% } %>
                        <% datos.clientes.forEach(function(c) { %><tr><td><%= c.id_cliente %></td><td><%= c.nombre %></td><td><%= c.email %></td><td><%= c.ciudad %></td></tr><% }) %>
                        </tbody>
                    </table></div>
                </div>
            </div>
            <div class="col-lg-6 reveal" style="--i: 1">
                <div class="tabla-tarjeta vidrio h-100">
                    <div class="p-3 pb-0"><h2 class="h5"><i class="bi bi-flower2 me-2"></i>producto <small class="text-muted">(PostgreSQL)</small></h2></div>
                    <div class="table-responsive"><table class="table tabla-eco align-middle">
                        <thead><tr><th>ID</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Stock</th></tr></thead>
                        <tbody>
                        <% if (!datos.productos.length) { %><tr><td colspan="5" class="text-center text-muted py-3">Sin productos todavía</td></tr><% } %>
                        <% datos.productos.forEach(function(p) { %><tr><td><%= p.id_producto %></td><td><%= p.nombre %></td><td><%= p.categoria %></td><td>$<%= formatPrice(p.precio) %></td><td><%= p.stock %></td></tr><% }) %>
                        </tbody>
                    </table></div>
                </div>
            </div>
        </div>

        <div class="tabla-tarjeta vidrio reveal mb-4">
            <div class="p-3 pb-0"><h2 class="h5"><i class="bi bi-receipt me-2"></i>factura <small class="text-muted">(MySQL, leída directamente)</small></h2></div>
            <div class="table-responsive"><table class="table tabla-eco align-middle">
                <thead><tr><th>ID</th><th>Número</th><th>Cliente</th><th>Producto</th><th>Cant.</th><th>Total</th><th>Estado</th><th>Fecha</th></tr></thead>
                <tbody>
                <% if (!datos.facturas.length) { %><tr><td colspan="8" class="text-center text-muted py-3">Sin facturas todavía</td></tr><% } %>
                <% datos.facturas.forEach(function(f) { %><tr><td><%= f.id_factura %></td><td><%= f.numero %></td><td><%= f.id_cliente %></td><td><%= f.id_producto %></td><td><%= f.cantidad %></td><td>$<%= formatPrice(f.total) %></td><td><%= f.estado %></td><td><%= f.fecha %></td></tr><% }) %>
                </tbody>
            </table></div>
        </div>
    <% } %>

    <div class="acciones-pie">
        <a href="/admin" class="btn btn-suave"><i class="bi bi-arrow-left me-2"></i>Volver al panel</a>
    </div>
</div>

<%- include(partial('footer')) %>
