<%- include(partial('header')) %>
<%
    // Icono y color de cada estado en el menú desplegable (mismos tonos que las etiquetas de estado).
    var ICONOS_ESTADO = {
        pendiente: ['bi-hourglass-split', 'ambar'],
        confirmado: ['bi-check2-circle', 'azul'],
        en_camino: ['bi-truck', 'indigo'],
        entregado: ['bi-box-seam', 'verde'],
        cancelado: ['bi-x-circle', 'rojo']
    };
%>

<div class="container contenedor-pagina">
    <div class="panel-cabecera reveal">
        <span class="panel-icono"><i class="bi bi-truck"></i></span>
        <div>
            <h1>Pedidos / Domicilios</h1>
            <p><%= pedidos.length %> pedido<%= pedidos.length === 1 ? '' : 's' %> en total</p>
        </div>
    </div>

    <% if (!pedidos.length) { %>
    <div class="vacio vidrio reveal">
        <i class="bi bi-box-seam"></i>
        <p class="mt-3 text-muted mb-0">Aún no hay pedidos registrados.</p>
    </div>
    <% } else { %>
    <div class="tabla-tarjeta vidrio reveal">
        <div class="table-responsive">
            <table class="table tabla-eco align-middle">
                <thead><tr><th>#</th><th>Cliente</th><th>Total</th><th>Estado</th><th>Fecha</th><th>Acción</th></tr></thead>
                <tbody>
                    <% pedidos.forEach(function(pedido, i) { %>
                    <tr style="--i: <%= i %>">
                        <td><strong><%= pedido.id_pedido %></strong></td>
                        <td><%= pedido.cliente %><br><small class="text-muted"><%= pedido.email %></small></td>
                        <td><strong>$<%= formatPrice(pedido.total) %></strong></td>
                        <td><span class="estado estado-<%= pedido.estado %>"><%= String(pedido.estado).replace('_', ' ') %></span></td>
                        <td><%= formatDate(pedido.fecha_pedido) %></td>
                        <td>
                            <form method="POST" action="/admin/pedidos" class="d-flex gap-2">
                                <input type="hidden" name="id_pedido" value="<%= pedido.id_pedido %>">
                                <select name="estado" class="form-select form-select-sm" style="width: 170px;" aria-label="Estado del pedido <%= pedido.id_pedido %>">
                                    <% ESTADOS.forEach(function(estado) { var marca = ICONOS_ESTADO[estado] || ['bi-circle', 'verde']; %>
                                        <option value="<%= estado %>" data-icono="<%= marca[0] %>" data-tono="<%= marca[1] %>" <%= pedido.estado === estado ? 'selected' : '' %>><%= ucfirst(estado).replace('_', ' ') %></option>
                                    <% }) %>
                                </select>
                                <button type="submit" name="cambiar_estado" class="btn btn-sm btn-ecoflora">Actualizar</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <div class="acciones-pie">
        <a href="/admin" class="btn btn-suave"><i class="bi bi-arrow-left me-2"></i>Volver al panel</a>
    </div>
</div>

<%- include(partial('footer')) %>
