<%- include(partial('header')) %>

<div class="container contenedor-pagina">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <div class="nosotros-collage" data-collage>
                <% destacadas.slice(0, 3).forEach(function(planta, i) { %>
                <figure class="collage-foto cf-<%= i + 1 %>">
                    <a href="/planta/<%= planta.id_planta %>"><%- plantImg(planta, { eager: true, width: 480, height: 480 }) %></a>
                    <figcaption><%= planta.nombre %></figcaption>
                </figure>
                <% }) %>
            </div>
        </div>
        <div class="col-lg-6 reveal">
            <span class="seccion-etiqueta"><i class="bi bi-flower2"></i>Nuestra historia</span>
            <h1 class="seccion-titulo text-start">Somos EcoFlora</h1>
            <p class="lead">Desde 2020 conectamos personas con la naturaleza. Somos un vivero especializado en plantas de interior, exterior, suculentas y orquídeas de la más alta calidad.</p>
            <p>Nuestro equipo de expertos está listo para asesorarte en el cuidado de cada planta. Hacemos domicilios seguros a toda la ciudad para que la naturaleza llegue a tu hogar sin complicaciones.</p>
            <div class="row g-3 mt-3">
                <div class="col-4"><div class="contador vidrio"><strong data-contar="500" data-sufijo="+">500+</strong><small>Plantas vendidas</small></div></div>
                <div class="col-4"><div class="contador vidrio"><strong data-contar="200" data-sufijo="+">200+</strong><small>Clientes felices</small></div></div>
                <div class="col-4"><div class="contador vidrio"><strong data-contar="50" data-sufijo="+">50+</strong><small>Especies</small></div></div>
            </div>
            <div class="hero-botones mt-4" style="animation: none;">
                <a href="/catalogo" class="btn btn-ecoflora btn-lg"><i class="bi bi-grid me-2"></i>Ver catálogo</a>
                <a href="/contacto" class="btn btn-outline-ecoflora btn-lg">Contáctanos</a>
            </div>
        </div>
    </div>
</div>

<%- include(partial('footer')) %>
