MONGODB_URI=mongodb://127.0.0.1:27017/ecoflora
# Firma la cookie de sesión. En producción (NODE_ENV=production) es OBLIGATORIA: sin ella el servidor no arranca.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# En producción pon NODE_ENV=production (en tu computador déjalo vacío o en development).
# NODE_ENV=development
# Contraseña con la que se CREA el usuario admin (mínimo 8 caracteres; solo si el admin aún no existe).
# En tu computador, si la dejas vacía, el admin nace con la contraseña de pruebas; en producción se genera una
# aleatoria y se muestra una sola vez en el log.
ADMIN_INITIAL_PASSWORD=
PORT=3000

# Correo del formulario de contacto (Resend, https://resend.com).
# Sin RESEND_API_KEY los mensajes igual se guardan y se leen en /admin/mensajes.
RESEND_API_KEY=
# A quién le llegan los mensajes (por defecto mariazabache0510@gmail.com).
CONTACT_TO_EMAIL=mariazabache0510@gmail.com
# Remitente. Mientras no verifiques un dominio en Resend, déjalo como está.
CONTACT_FROM_EMAIL=EcoFlora <onboarding@resend.dev>

# Inicio de sesión con rostro. Los rostros se guardan CIFRADOS con esta clave.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin clave, el inicio con rostro queda apagado. Si la pierdes o la cambias, cada persona
# tendrá que registrar su rostro de nuevo.
FACE_ENCRYPTION_KEY=
# Qué tan parecido debe ser el rostro (menor = más estricto). 0.5 es un buen punto de partida.
FACE_MATCH_THRESHOLD=0.5
# (La cuenta admin entra solo con contraseña: el rostro es solo para clientes.)

# ---------------------------------------------------------------------------------------------
# Parcial final: sistema de información híbrido (ver sección 10 del README). Nada de esto se sube.
# ---------------------------------------------------------------------------------------------
# Entrar con Google. Créalo en Google Cloud > APIs y servicios > Credenciales > ID de cliente de OAuth
# (tipo "Aplicación web"). Orígenes autorizados: http://localhost:3000 y https://ecoflora-node.onrender.com
# Sin este valor el botón "Continuar con Google" no aparece.
GOOGLE_CLIENT_ID=
# Mapa de "Sitios de interés" (Maps JavaScript API). Restringe la llave por dominio (HTTP referrers):
# http://localhost:3000/* y https://ecoflora-node.onrender.com/*
GOOGLE_MAPS_API_KEY=
# Base de datos de los sitios: CockroachDB Cloud (cuenta gratis). Pega la cadena de conexión que te da el
# botón "Connect" del cluster (empieza con postgresql://). SSL es obligatorio. Sin esto /sitios avisa que
# no está disponible.
COCKROACH_URL=
# Dirección pública del sitio (la usa el enlace del correo de "recuperar contraseña"). En Render se toma sola.
# En tu computador, si la dejas vacía, se usa la dirección con la que abriste la página.
PUBLIC_URL=

# Base federada (Parte 2). SOLO EN TU COMPUTADOR, con los servidores de docker/ encendidos
# (cd docker && cp .env.example .env && docker compose up -d --build). En Render se dejan vacías (apagada).
# Las contraseñas y el puerto son los de docker/.env (PG_PASSWORD / PG_PORT y MYSQL_APP_PASSWORD / MYSQL_PORT).
# PG_URL=postgres://ecoflora:LA_CLAVE_DE_PG_PASSWORD@127.0.0.1:5433/ecoflora_pg
# MYSQL_URL=mysql://ecoflora_app:LA_CLAVE_DE_MYSQL_APP_PASSWORD@127.0.0.1:3307/ecoflora_facturas
PG_URL=
MYSQL_URL=
