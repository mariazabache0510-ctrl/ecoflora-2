MONGODB_URI=mongodb://127.0.0.1:27017/ecoflora
SESSION_SECRET=cambia-esto-en-produccion
PORT=3000

# Correo del formulario de contacto (Resend, https://resend.com).
# Sin RESEND_API_KEY los mensajes igual se guardan y se leen en /admin/mensajes.
RESEND_API_KEY=
# A quién le llegan los mensajes (por defecto mariazabache0510@gmail.com).
CONTACT_TO_EMAIL=mariazabache0510@gmail.com
# Remitente. Mientras no verifiques un dominio en Resend, déjalo como está.
CONTACT_FROM_EMAIL=EcoFlora <onboarding@resend.dev>

# Inicio de sesión con rostro. Los rostros se guardan CIFRADOS con esta clave.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin clave, el inicio con rostro queda apagado. Si la pierdes o la cambias, cada persona
# tendrá que registrar su rostro de nuevo.
FACE_ENCRYPTION_KEY=
# Qué tan parecido debe ser el rostro (menor = más estricto). 0.5 es un buen punto de partida.
FACE_MATCH_THRESHOLD=0.5
# Umbral de la cuenta admin (opcional; por defecto es 0.05 más estricto que el general).
# FACE_MATCH_THRESHOLD_ADMIN=0.45
