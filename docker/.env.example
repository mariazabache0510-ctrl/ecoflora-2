# Copia este archivo como docker/.env y cambia los valores. docker/.env está en .gitignore: NO lo subas.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_APP_PASSWORD=cambia-esta-clave-app-mysql
FDW_MYSQL_PASSWORD=cambia-esta-clave-fdw
PG_PASSWORD=cambia-esta-clave-postgres
# Puertos en tu computador (cámbialos solo si ya los usa otro programa):
PG_PORT=5433
MYSQL_PORT=3307
